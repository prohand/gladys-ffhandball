{
  "manifest_version": 1,
  "type": "device",
  "name": "FFHandball",
  "description": {
    "en": "Follow French handball teams: results, standings and next matches from ffhandball.fr.",
    "fr": "Suivez vos équipes de handball : résultats, classements et prochains matchs FFHandball.",
    "de": "Verfolge französische Handballteams: Ergebnisse, Tabellen und Spiele von ffhandball.fr.",
    "es": "Siga equipos de balonmano franceses: resultados, clasificación y partidos de ffhandball.fr."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/prohand/gladys-ffhandball:1.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-ffhandball/main/cover.png",
  "categories": ["leisure", "services"],
  "keywords": [
    "ffhb",
    "fédération handball",
    "starligue",
    "proligue",
    "ligue butagaz énergie",
    "nationale 1",
    "championnat",
    "club",
    "sport",
    "score"
  ],
  "countries": ["FR"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "On www.ffhandball.fr, open Competitions, pick the season, the competition, then click your team: copy the address of that page (it ends with /equipe-<number>/) and paste it below, one team per line. Don't know where your team plays? Paste the address of the competition in the \"List the teams of a competition\" button. No account, no key: the integration reads the public website.",
        "fr": "Sur www.ffhandball.fr, ouvrez Compétitions, choisissez la saison, la compétition, puis cliquez sur votre équipe : copiez l'adresse de cette page (elle finit par /equipe-<numéro>/) et collez-la ci-dessous, une équipe par ligne. Vous ne trouvez pas la page de l'équipe ? Collez l'adresse de la compétition dans le bouton « Lister les équipes d'une compétition ». Pas de compte, pas de clé : l'intégration lit le site public.",
        "de": "Öffne auf www.ffhandball.fr den Bereich Compétitions, wähle die Saison, den Wettbewerb und klicke auf deine Mannschaft: Kopiere die Adresse dieser Seite (sie endet mit /equipe-<Nummer>/) und füge sie unten ein, eine Mannschaft pro Zeile. Du findest die Seite nicht? Füge die Adresse des Wettbewerbs in die Schaltfläche „Mannschaften eines Wettbewerbs auflisten“ ein. Kein Konto, kein Schlüssel: Die Integration liest die öffentliche Website.",
        "es": "En www.ffhandball.fr, abra Compétitions, elija la temporada, la competición y haga clic en su equipo: copie la dirección de esa página (termina en /equipe-<número>/) y péguela abajo, un equipo por línea. ¿No encuentra la página? Pegue la dirección de la competición en el botón «Listar los equipos de una competición». Sin cuenta ni clave: la integración lee el sitio web público."
      },
      "links": [
        {
          "url": "https://www.ffhandball.fr/competitions/",
          "label": {
            "en": "ffhandball.fr competitions",
            "fr": "Compétitions ffhandball.fr",
            "de": "Wettbewerbe auf ffhandball.fr",
            "es": "Competiciones de ffhandball.fr"
          }
        },
        {
          "url": "https://github.com/prohand/gladys-ffhandball/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "teams",
      "type": "string",
      "label": {
        "en": "Teams",
        "fr": "Équipes",
        "de": "Mannschaften",
        "es": "Equipos"
      },
      "description": {
        "en": "Addresses of ffhandball.fr team pages, one per line. Each team becomes a Gladys device. Team pages change every season: paste the new address in September.",
        "fr": "Adresses des pages équipe de ffhandball.fr, une par ligne. Chaque équipe devient un appareil Gladys. Les pages équipe changent à chaque saison : collez la nouvelle adresse en septembre.",
        "de": "Adressen von Mannschaftsseiten auf ffhandball.fr, eine pro Zeile. Jede Mannschaft wird ein Gladys-Gerät. Die Mannschaftsseiten ändern sich jede Saison: Füge im September die neue Adresse ein.",
        "es": "Direcciones de páginas de equipo de ffhandball.fr, una por línea. Cada equipo se convierte en un dispositivo de Gladys. Las páginas cambian cada temporada: pegue la nueva dirección en septiembre."
      },
      "placeholder": {
        "en": "https://www.ffhandball.fr/competitions/saison-2026-2027-22/national/daikin-starligue-2026-27-32372/equipe-2119699/",
        "fr": "https://www.ffhandball.fr/competitions/saison-2026-2027-22/national/daikin-starligue-2026-27-32372/equipe-2119699/",
        "de": "https://www.ffhandball.fr/competitions/saison-2026-2027-22/national/daikin-starligue-2026-27-32372/equipe-2119699/",
        "es": "https://www.ffhandball.fr/competitions/saison-2026-2027-22/national/daikin-starligue-2026-27-32372/equipe-2119699/"
      },
      "required": false
    },
    {
      "key": "refresh_minutes",
      "type": "number",
      "label": {
        "en": "Refresh interval (minutes)",
        "fr": "Intervalle de rafraîchissement (minutes)",
        "de": "Aktualisierungsintervall (Minuten)",
        "es": "Intervalo de actualización (minutos)"
      },
      "description": {
        "en": "How often ffhandball.fr is read. The site itself refreshes its pages about once an hour: reading it more often brings results no sooner.",
        "fr": "Fréquence de lecture de ffhandball.fr. Le site lui-même rafraîchit ses pages environ une fois par heure : le lire plus souvent n'apporte pas les résultats plus tôt.",
        "de": "Wie oft ffhandball.fr gelesen wird. Die Website aktualisiert ihre Seiten selbst etwa einmal pro Stunde: Häufigeres Lesen bringt die Ergebnisse nicht früher.",
        "es": "Frecuencia de lectura de ffhandball.fr. El propio sitio actualiza sus páginas más o menos una vez por hora: leerlo más a menudo no adelanta los resultados."
      },
      "required": false,
      "default": 30,
      "min": 5,
      "max": 1440
    },
    {
      "key": "reminder_minutes",
      "type": "number",
      "label": {
        "en": "Match reminder (minutes before kick-off)",
        "fr": "Rappel de match (minutes avant le coup d'envoi)",
        "de": "Spielerinnerung (Minuten vor Anpfiff)",
        "es": "Aviso de partido (minutos antes del inicio)"
      },
      "description": {
        "en": "When the \"A match is about to start\" scene trigger fires. 0 fires it at kick-off.",
        "fr": "Moment où le déclencheur de scène « Un match va commencer » se déclenche. 0 le déclenche au coup d'envoi.",
        "de": "Wann der Szenenauslöser „Ein Spiel beginnt gleich“ auslöst. 0 löst ihn beim Anpfiff aus.",
        "es": "Cuándo se activa el disparador de escena «Un partido va a empezar». 0 lo activa al inicio del partido."
      },
      "required": false,
      "default": 60,
      "min": 0,
      "max": 1440
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the device texts",
        "fr": "Langue des textes des appareils",
        "de": "Sprache der Gerätetexte",
        "es": "Idioma de los textos de los dispositivos"
      },
      "description": {
        "en": "Language of the feature names and of the texts published as states (last match, next match) and in scene variables. The widgets follow the reader's own language.",
        "fr": "Langue des noms des fonctionnalités et des textes publiés comme états (dernier match, prochain match) et dans les variables de scène. Les widgets suivent la langue du lecteur.",
        "de": "Sprache der Funktionsnamen und der als Zustände veröffentlichten Texte (letztes Spiel, nächstes Spiel) sowie der Szenenvariablen. Die Widgets folgen der Sprache des Lesers.",
        "es": "Idioma de los nombres de las funciones y de los textos publicados como estados (último partido, próximo partido) y en las variables de escena. Los widgets siguen el idioma del lector."
      },
      "required": false,
      "default": "fr",
